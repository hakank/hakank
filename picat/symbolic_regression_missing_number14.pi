import util.
data(missing_number14,Data,Vars,Unknown,Ops,Constants,MaxSize,Params) :-

  Data = [[[7,9,8],2],
          [[2,7,4],8]
         ],
  Vars = ['A','B','C'],
  Unknown = [5,6,9],
  
  Ops = [+,*,-,/,mod],
  % Ops = [+,-,*,div,gcd,lcm],
  % Ops = [+,-,*,div,gcd,lcm],  
  Constants = 1..10,
  MaxSize = 1,
  Params = new_map([
                     init_size=1000,
                     num_gens=1000
                   ]).
