% import util.
data(test,Data,Vars,Unknown,Ops,Constants,MaxSize,Params) :-
  Data = [ [[I],cond(is_power_of_two(I),1,0)] : I in 1..31],
  Unknown = [32],
  % Unknown = [16],  
  Vars = ['N'],
  % Ops = [/\,\/,~],   
  % Ops = [/\,-,cond,==],
  Ops = [/\,-,==],
  Constants = 0..1,
  
  % Ops = [+,-,*,div,gcd],
  % Ops = [+,-,*,div,mod],
  % Ops = [+,-,*,div],
  % Constants = 0..32,
  
  MaxSize = 11,
  Params = new_map([init_size=1000,
                    % unique_vars_all=true,
                    num_gens=100
                 ]).

is_power_of_two(N) =>
  N /\ (N - 1) == 0.
