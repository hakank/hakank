go ?=>
  reset_store(),
  run_model(30_000,$model,[show_probs_rat,mean]),
  fail,
  nl.
go => true.

model() =>
  Tiles = 18,
  People = 16,

  Known = 0,
  R = [],
  foreach(P in 1..People)
    Alive = true,
    while (Alive, Known < Tiles)
      Alive := flip(1/2),
      Known := Known + 1
    end,
    R := R ++ [Alive]       
  end,
  add("R",R),
  add("num_survived",[ cond(R[I]==true,1,0) : I in 1..People].sum),
  foreach(P in 1..People)
    add("R"++P.to_string,R[P])
  end.
  