go ?=>
  _ = random2(),
  Data = [[I,I*2+normal_dist(0,1)] : I in 0..10],
  % Data = normal_dist_n(100,15,100),
  % Data = poisson_dist_n(5,100),
  % Data = [[normal_dist(0,1),normal_dist(0,1)] : I in 1..300],
  % Data = beta_dist_n(10,10,100),
  % Data = student_t_dist_n(1,100),

  show_scatter_plot(Data,30,20),
  nl.
go => true.


