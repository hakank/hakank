go3 => true.
  
  
model3() =>
  % X = [15.281819132444104,10.028270196182174,14.014207692800706,9.901431868321195,22.504941544790793,35.934094047899976,10.887493952334752,5.223940870946778,22.304607209505008,0.61166403311217],
  X = [15.281819132444104,10.028270196182174,14.014207692800706],
  Alpha = uniform(0,20),
  Beta = uniform(0,10),
  foreach(I in 1..X.len)
    observe( abs(extreme_value_dist(Alpha,Beta)-X[I]) <= 1.0)
    % observe( abs( normal_dist(extreme_value_dist(Alpha,Beta),10)-X[I]) <= 1.0)
  end,
  Post = extreme_value_dist(Alpha,Beta),
  if observed_ok then
    % println(Alpha=Beta=Post),
    add("alpha",Alpha),
    add("beta",Beta),
    add("post",Post)
  end.
