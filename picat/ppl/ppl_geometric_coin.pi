go ?=>
  reset_store(),
  run_model(10000,geometric_coin,),
  ExactProb = 1-geometric_dist_cdf(1/2,3),
  println(using_cdf=ExactProb.and_rat),
  nl,
  println(samples=[geometric_dist(1/2) : _ in 1..20]),
  nl.
go => true.

geometric_coin() =>
  V = geometric_dist(1/2),
  P_at_least_4 = cond(V >= 4,1,0),
  add_all([["p_at_least_4",P_at_least_4],
           ["V",V]]).
 