go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean,show_hpd_intervals,hpd_intervals=[0.84]]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  % Sigma = 1,
  Sigma = 0.1, % better precision
  Arrow1 = normal_dist(0,Sigma),
  Arrow2 = normal_dist(0,Sigma),
  Arrow3 = normal_dist(0,Sigma),  
  
  observe( abs(Arrow1) < abs(Arrow2)),

  P = check(abs(Arrow3) < abs(Arrow1)),
  
  if observed_ok then
    add("arrow1",Arrow1),
    add("arrow2",Arrow2),
    add("arrow3",Arrow3),
    add("p",P)
  end.


