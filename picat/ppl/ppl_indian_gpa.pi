*/
go ?=>
  reset_store,
  run_model(30_000,$model,[show_probs_trunc,mean]),
  nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  %  Note: In https://probprog.github.io/anglican/examples/viewer/?worksheet=indian-gpa
  %        the proportions are a little different.
  % Nationality = categorical([0.75,0.25],["india","usa"]),
  Nationality = categorical([0.5,0.5],["india","usa"]),

  Perfect = cond(Nationality == "india",
                  flip(0.10),
                  flip(0.15)),

  GPA = cond(Nationality == "india",
              condt(Perfect,
                    10.0,
                    uniform(0,10)),
              condt(Perfect,
                    4.0,
                    uniform(0,4))),
 
  % Observations:
  observe((GPA <= 4.0, abs(GPA-4.0) <= 0.01)), % Observe GPA=4.0
  % observe(abs(GPA-3.0) <= 0.01), % Observe GPA=3.0
  % observe(abs(GPA-4.1) <= 0.01), % Observe GPA=4.1
  % observe(Perfect),
  % observe(not Perfect),
  % observe(Nationality == "usa"),
  % observe(Nationality == "india"),  
  
  if observed_ok then
    add("nationality",Nationality),
    add("perfect",Perfect),
    add("gpa",GPA),        
  end.
