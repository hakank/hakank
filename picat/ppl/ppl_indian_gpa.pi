  * Observe nationality = india
    var : gpa
    Probabilities (truncated):
    10.0: 0.0998320456835741
    9.999500494450098: 0.0000671817265704
    9.99838771764114: 0.0000671817265704
    9.997837655245251: 0.0000671817265704
    .........
    0.003043222242521: 0.0000671817265704
