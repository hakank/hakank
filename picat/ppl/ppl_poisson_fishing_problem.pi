go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs,mean,show_histogram]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  Lambda = 6/10,

  Fishing = [],
  while (Fishing.sum == 0)
    NumFish = poisson_dist(Lambda),
    Fishing := Fishing ++ [NumFish]
  end,

  Len = Fishing.len,
  Total = Fishing.sum,

  P = check( (Len >= 2, Len <= 5)),
  
  add("len",Len),
  add("total",Total),
  add("p",P).

