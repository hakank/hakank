go ?=>
  member(Test,[impala,waterbuck]),
  println(test=Test),
  reset_store,
  run_model(10_000,$model(Test),[show_probs_trunc,mean,
                                 show_hpd_intervals,hpd_intervals=[0.84],
                                 min_accepted_samples=100 % , show_accepted_samples=true
                                 ]),
  nl,
  fail,
  nl.
go => true.
  
  
model(Test) =>
  MaxN = 1000,

  ImpalaL = [15,20,21,23,26],
  WaterbuckL = [53,57,66,67,72],

  if Test == impala then
    Data = ImpalaL
  else
    Data = WaterbuckL
  end,
  Len = Data.len,
  
  Beta1 = uniform(0.1,100),
  Beta2 = uniform(0.1,100),
  
  Theta = beta_dist(Beta1,Beta2),

  % N = random_integer1(MaxN), 
  N = categorical([1/I : I in 1..MaxN],1..MaxN),
  
  X = binomial_dist_btpe_n(N,Theta, Len),

  % observe(X == Data),
  observe_abc(Data,X,1/2),
  
  if observed_ok then
    add("n",N),
    add("theta",Theta),
    add("beta1",Beta1),
    add("beta2",Beta2),    
  end.
