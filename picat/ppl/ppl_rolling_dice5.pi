  mean = 4.8911



*/
go ?=>
  member(N,2..3..11),
  member(Obs,[false,true]),
  println([n=N,observation=Obs]),
  reset_store,
  run_model(10_000,$model(N,Obs),[show_probs_trunc,mean]),
  nl,
  % show_store_lengths,
  fail,
  nl.
go => true.
  

roll(A,N) = Ret =>
  if A.len != A.remove_dups.len then
    Ret = A
  else
    Ret = roll(A++[random_integer1(N)],N)
  end.
model(N,Obs) =>
  A = roll([],N),

  if Obs == true then
    observe(A[1] == 1),
    if observed_ok then
      add("len",A.len)
    end
  else
    add("len",A.len)
  end.

