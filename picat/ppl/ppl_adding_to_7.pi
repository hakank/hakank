go ?=>
  reset_store,
  run_model(30_000,$model,[show_probs_trunc,mean,show_histogram]),
  nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  N = 100,

  A = poisson_dist(N) - N,
  B = poisson_dist(N) - N,  
  
  observe( abs(  normal_dist(A+B,0.0001)-7) <= 0.01),
  
  if observed_ok then
    add("a",A),
    add("b",A),
    add("a+b",A+B)
  end.
