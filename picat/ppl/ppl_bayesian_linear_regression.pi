go ?=>
  Ys = [0,1,4,6],
  run_model(40_000,$model(Ys),[show_probs_trunc,mean,show_percentiles,show_hpd_intervals,show_histogram]),
  % run_model(30_000,$model(Ys),[mean]),  
  % fail,
  nl.
go => true.
  
  
model(Ys) =>
  Len = Ys.len,
  M = normal_dist(0,2),
  B = normal_dist(0,2),
  Sigma = gamma_dist(1,1),

  Y = [normal_dist(M * (I-1) + B,Sigma) : I in 1..Len],
  C = 0,
  foreach(I in 1..Len)
    if abs(Ys[I]-Y[I]) <= 1.0 then
      C := C + 1
    end
  end,
  observe(C == Len),
  Y4 = normal_dist(M * (4-1) + B,Sigma),
  add("c",C),

  if observed_ok then
    add("m",M),
    add("b",B),
    add("sigma",Sigma),
    add("y4",Y4),
  end.
