go ?=>
  GuessVal = 9.5,
  reset_store,
  run_model(10_000,$model(GuessVal),[show_probs_trunc,mean,variance,show_histogram]),
  nl,
  % show_store_lengths,
  % fail,
  nl.
go => true.
  
  
model(GuessVal) =>
  Guess       = GuessVal,
  Weight      = normal_dist(Guess,1.0),
  Measurement = normal_dist(Weight,0.75),

  observe(abs(normal_dist(Weight,1)-Guess)<0.1),

  if observed_ok then
    add("weight",Weight),
    add("measurement",Measurement),    
  end.
