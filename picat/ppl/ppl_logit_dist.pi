go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean,
                           show_percentiles,
                           show_hpd_intervals,hpd_intervals=[0.5,0.84,0.95],
                           show_histogram
                           % min_accepted_samples=1000,show_accepted_samples=true
                          ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  

logit(P) = log(P/(1-P)).
logit_dist() = logit(U) =>
  U = uniform(0,1).

model() =>
  
  D  = logit_dist(),
  add("d",D).

