/* 

  Student performance in Picat.

  Port of the WebPPL model from
  https://medium.com/@linz07m/understanding-probabilistic-programming-a-simple-demonstration-using-webppl-6a1121402bce
  """
  Let’s model a scenario where a student’s exam performance is uncertain.
  Factors like their study hours, sleep, and past performance influence their grade.

  // Define the model
  var studentModel = function() {
    // Prior belief: How well the student performs on average
    var basePerformance = gaussian(70, 10); // Mean: 70, Std Dev: 10
  
    // Study hours factor: More hours improve performance
    var studyHours = uniform(0, 10); // Study hours between 0 and 10
    var studyEffect = studyHours * 3; // Each hour adds 3 points on average
  
    // Sleep factor: Poor sleep reduces performance
    var sleepQuality = bernoulli(0.8); // 80% chance of good sleep
    var sleepEffect = sleepQuality ? 5 : -10; // Good sleep adds, bad sleep reduces
  
    // Final grade calculation
    var grade = basePerformance + studyEffect + sleepEffect;
  
    // Observation: Real-world observed grade
    condition(grade > 85); // Observed that the grade was above 85
  
    return grade;
  };

  // Run inference to predict grade distribution
  var predictedGrades = Infer({ method: "MCMC", samples: 1000 }, studentModel);

  // Display the results
  viz(predictedGrades);
  """


  Cf my Gamble model gamble_student_performance.rkt

  This program was created by Hakan Kjellerstrand, hakank@gmail.com
  See also my Picat page: http://www.hakank.org/picat/

*/

import ppl_distributions, ppl_utils.
import util.
% import ordset.

main => go.

