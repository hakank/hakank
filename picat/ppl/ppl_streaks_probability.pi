go ?=>
  N = 200,
  P = 85/100,
  R = 20,
  println(pp=pp(N,P,R)),
  nl,
  foreach(RR in 0..N)
    P1 = probability_of_run_size(N,P,RR),
    P2 = pp(N,P,RR),
    Diff = P1 - P2,
    printf("r: %3d p1: %.10f p2: %.10f diff:%.10f\n",RR,P1,P2,Diff)
  end,
  nl.
go => true.
 