import ppl_distributions, ppl_utils.
import util.
% import ordset.

main => go.

% Loop until the runs of xs are "settled", normally a single number
% Returns the last xs and the number of iterations
runs_loop(A) = runs_loop1(A,0,false).
runs_loop(A,Trace) = runs_loop1(A,0,Trace).
runs_loop1(A,I,Trace) = Res =>
  if Trace == true then
    println("runs_loop"=A=A.len)
  end,
  NewA = get_runs_lens(A),
  if A == NewA then
    Res = [A,I]
  else
    Res = runs_loop1(NewA,I+1,Trace)
  end.


