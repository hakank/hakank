  (83 0.9989127057672491)
  (84 0.9990000770593404)
  (85 0.9990804274895049)
  ...
  (275 0.9999999998874667)
  (276 0.9999999998965095)
  (277 0.9999999999048257)
  (278 0.9999999999124736)
  (279 0.9999999999195068)
  (280 0.999999999925975)
  (281 1.0)

  Quantile
  0.0001: 3
