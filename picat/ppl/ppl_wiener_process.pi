/* 

  Wiener process in Picat.

  From Mathematica WienerProcess
  """
  The state at time t follows NormalDistribution[Mu t,Sigma Sqrt[t]]
  """

  For more, see ppl_distributions.pi and ppl_distributions_test.pi

  Cf my Gamble model gamble_wiener_process.rkt

  This program was created by Hakan Kjellerstrand, hakank@gmail.com
  See also my Picat page: http://www.hakank.org/picat/

*/

import ppl_distributions, ppl_utils.
import util.
% import ordset.

main => go.

