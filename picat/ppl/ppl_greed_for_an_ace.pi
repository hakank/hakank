go ?=>
  Deck = [1..13 : _ in 1..4].flatten,
  reset_store,
  run_model(20_000,$model(Deck),[show_probs_trunc,mean,show_histogram,histogram_limit=100]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model(Deck) =>
  
  % ShuffledDeck = shuffle(Deck), 
  ShuffledDeck = draw_without_replacement(Deck.len,Deck),
  FirstAce = find_first_of(ShuffledDeck,1),
  add("first ace",FirstAce).

