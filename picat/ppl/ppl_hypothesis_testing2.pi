go ?=>
  Scores = [62.9,92.0,75.0,68.0,83.0,95.0],
  println(mean=Scores.mean),
  reset_store,
  run_model(10_000,$model(Scores),[show_probs_trunc,mean,
                           show_percentiles,
                           show_hpd_intervals,hpd_intervals=[0.9],
                           show_histogram
                           % min_accepted_samples=1000,show_accepted_samples=true
                          ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model(Scores) =>
  Sample = resample(Scores),

  M = Sample.mean,
  % What is the probability of a mean < 70
  P = check(M < 70), 
  add("m",M),
  add("p",P).

