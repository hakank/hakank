  11 0.001995839999998 
  12 0.006187103999997 
  13 0.014270255999997 
  14 0.027315864575996 
  15 0.045950224319996 
  16 0.070309810771196 
  17 0.100094429635195 
  18 0.134672620008322 
  19 0.173201547619896 
  20 0.214737323197396 

  Quantile:
  0.000001 10 
  0.00001 10 
  0.001 11 
  0.01 13 
  0.025 14 
  0.05 16 
  0.25 21 
  0.5 27 
  0.75 35 
  0.84 39 
  0.975 57 
  0.99 66 
  0.999 88 
  0.99999 132 
  0.999999 153 

  mean:
  mean = 29.2897
  mean_euler = 29.298

  variance:
  mean = 125.687


*/
go ?=>
  M = 10,
  println(m=M),
  println("Random:"),
  println(coupon_collector_dist_n(M,M,10)),
  nl,
  println("PDF:"),
  [K=coupon_collector_dist_pdf(M,M,K) : K in M..M*2].printf_list,
  nl,
  println("CDF:"),
  [K=coupon_collector_dist_cdf(M,M,K) : K in M..M*2].printf_list,
  nl,
  println("Quantile:"),
  Qs = quantile_qs(),
  [Q=coupon_collector_dist_quantile(M,M,Q) : Q in Qs].printf_list,
  nl,
  println("mean:"),
  println(mean=coupon_collector_dist_mean(M,M)),
  println(mean_euler=coupon_collector_dist_mean_euler(M)),
  nl,
  println("variance:"),
  println(mean=coupon_collector_dist_variance(M,M)),

  nl.
go => true.

