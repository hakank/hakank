go ?=>
  _ = random2(),
  member(T,1..4),
  NumBombs = 20,
  if flip(0.5) = true then
    println(uniform_bombing),
    Points = uniform_bombing(NumBombs)
  else
    println(target_bombing),  
    Points = target_bombing(NumBombs)
  end,
  show_scatter_plot(Points),
  nl,
  nl,
  fail,
  nl.
go => true.
  
  
