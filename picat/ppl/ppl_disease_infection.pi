go ?=>
  member(EstimateP,[false,true]),
  println(estimate_p=EstimateP),
  reset_store,
  run_model(10_000,$model(EstimateP),[show_probs_trunc,mean,
                          show_hpd_intervals,hpd_intervals=[0.84]]),
  nl,
  % show_store_lengths,
  fail,
  nl.
go => true.
  
  
model(EstimateP) =>
  NumInfected = 100,
  NumPeople = 500 + random_integer(1000),
  
  % The probability p for num_met is hardcoded to 0.5 in the SPPL model,
  %  but let's go crazy and estimate it as well.    
  %  Change estimate-p above to #t for that.
  P = condt(EstimateP, uniform(0,1),0.5),

  NumMet = binomial_dist(NumPeople,P),

  observe(binomial_dist(NumMet, 0.3) == NumInfected),

  if observed_ok then
    add("num people",NumPeople),
    add("num met",NumMet),
    add("num infected",NumInfected),
    add("p",P),
  end.
