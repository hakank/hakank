go ?=>
  N = 6,
  reset_store,
  run_model(10_000,$model(N),[show_probs,mean]),
  nl,
  % show_store_lengths,
  % fail,
  nl.
go => true.
  
roll(T,N) = Ret =>
  R = random_integer1(N),
  if R == N then
    Ret = T
  else
    Ret = roll(T+1,N)
  end.
% Another approach
roll2(T,N) = cond(R==N,T,roll2(T+1,N)) => R = random_integer1(N).  
model(N) =>
  T = roll2(1,N),
  add("t",T).

