go ?=>
  Runs = 10000,
  member(N,[25,50,100,200,250,300,500,1000]),
  nl,
  println(n=N),
  reset_store,
  run_model(Runs,$snake_eyes(N),[show_probs,mean,show_histogram]),
  println(exact=binomial_dist_pdf(N,1/36,6).and_rat),  
  nl,
  fail,
  nl.
go => true.
  
snake_eyes(N) =>  
  S = [ cond( (dice(6)==1,dice(6)==1),1,0)   : _ in 1..N].sum,
  P1 = cond(S >= 5,1,0), % What is the probability that we see 5 or more snake eyes?
  P2 = cond(S == 5,1,0), % What is the probability that we see exactly 5snake eyes?    
  add("s",S),
  add("p1",P1),
  add("p2",P2).
