go => true.
  
  
model(Control,Treatment) =>
  N = Control.len,

  IsEffective   = flip(0.5),
  ProbControl   = beta_dist(1,1),
  ProbTreatment = beta_dist(1,1),
  ProbAll       = beta_dist(1,1),

  C = [ cond(IsEffective==true,bern(ProbControl),bern(ProbAll)) : I in 1..N],
  T = [ cond(IsEffective==true,bern(ProbTreatment),bern(ProbAll)) : I in 1..N],

  % Scale the acceptable error interval
  observe_abc(Control[1..N],C,1/14),
  observe_abc(Treatment[1..N],T,1/14),

  if observed_ok then
    add("is effective",IsEffective),
    add("prob control",ProbControl),
    add("prob treatment",ProbTreatment),
    add("prob all",ProbAll),    
  end.
