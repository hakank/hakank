go ?=>
  reset_store,
  run_model(10_000,$model),
  nl,
  % show_store_lengths,
  % fail,
  nl.
go => true.
  
model() =>
  H = hypergeometric_dist(10,40,100),
  P = check(H >= 7),
  add("h",H),
  add("p",P).
