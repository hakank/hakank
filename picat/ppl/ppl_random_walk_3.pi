go ?=>
  _ = random2(),
  A = random_integer1(10),
  B = random_integer1(10),
  println([a=A,b=B,theoretical_num_steps=(A*B),theoretical_last_value_a=(B/(A+B))]),
  reset_store,
  run_model(10_000,$model(A,B),[show_probs_trunc,mean,show_histogram]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  

f(Lst,A,B) = Res =>
  if membchk(A,Lst) ; membchk(-B,Lst) then
    Res = Lst
  else
    Res = f(Lst ++ [Lst.last + uniform_draw([-1,1])],A,B)
  end.

model(A,B) =>
  Lst = f([0],A,B),
  NumSteps = Lst.len - 1,
  LastValue = Lst.last,
  P = check(LastValue > 0),
  add("num steps",NumSteps),  
  add("p",P),
  add("last value",LastValue).


