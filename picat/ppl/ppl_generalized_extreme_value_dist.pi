/* 

  Generalized extreme value dist in Picat.

  This is from Wikipedia 
  https://en.wikipedia.org/wiki/Generalized_extreme_value_distribution
  GEV(mu, sigma, xi)

  See ppl_distributions.pi and ppl_distributions_test.pi for more on this.

  Cf 
  - ppl_min_stable_dist.pi
  - ppl_max_stable_dist.pi
  - my Gamble model gamble_generalized_extreme_value_dist.rkt

  This program was created by Hakan Kjellerstrand, hakank@gmail.com
  See also my Picat page: http://www.hakank.org/picat/

*/

import ppl_distributions, ppl_utils.
import util.
% import ordset.

main => go.



