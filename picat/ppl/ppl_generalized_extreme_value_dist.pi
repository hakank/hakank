go2 ?=>
  reset_store,
  run_model(10_000,$model2,[show_probs_trunc,mean,
                           % show_percentiles,
                           truncate_size=10,
                           show_hpd_intervals,hpd_intervals=[0.84,0.9,0.99,0.999,0.9999,0.99999]
                           % show_histogram,
                           % min_accepted_samples=1000,show_accepted_samples=true
                          ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go2 => true.
  
  
model2() =>
  Mu = 10,
  Sigma = 3,
  Xi = 0.1,
  
  D = generalized_extreme_value_dist(Mu,Sigma,Xi),
  
  add("d",D).


