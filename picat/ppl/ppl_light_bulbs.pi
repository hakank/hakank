go3 ?=>
  reset_store,
  run_model(10_000,$model3,[show_probs_trunc,mean,variance,show_histogram]),
  nl,
  % show_store_lengths,
  % fail,
  nl.
go3 => true.
  
  
model3() =>
  Lambda = 2000,
  B1 = poisson_dist(Lambda), 
  B2 = poisson_dist(Lambda), 

  Diff = abs(B1-B2),
  P = check(Diff <= 25),
  
  add("bulb 1",B1),
  add("bulb 2",B2),  
  add("diff",Diff),
  add("p",P).
