*/
go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean,variance,show_histogram]),
  nl,
  % show_store_lengths,
  % fail,
  nl.
go => true.
  
  
model() =>
  Lambda = 1/2000, % Note: In Gamble it's 2000
  B1 = exponential_dist(Lambda),
  B2 = exponential_dist(Lambda),

  Diff = abs(B1-B2),
  P = check(Diff <= 25),
  
  add("bulb 1",B1),
  add("bulb 2",B2),  
  add("diff",Diff),
  add("p",P).


