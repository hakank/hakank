go2 ?=>
  reset_store,
  run_model(10_000,$model2,[show_probs_trunc,mean,variance,show_histogram]),
  nl,
  % show_store_lengths,
  % fail,
  nl.
go2 => true.
  
  
model2() =>
  Mu = 2000,
  Sigma = 100,
  B1 = normal_dist(Mu,Sigma), 
  B2 = normal_dist(Mu,Sigma), 

  Diff = abs(B1-B2),
  P = check(Diff <= 25),
  
  add("bulb 1",B1),
  add("bulb 2",B2),  
  add("diff",Diff),
  add("p",P).


