go ?=>
  reset_store,
  run_model(2_000,$model,[show_probs_trunc,truncate_size=10,mean,show_hpd_intervals,hpd_intervals=[0.84]]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
cum(I,Y) = Res =>
  if I == 1 then
    Res = Y[1] + 1
  else
    Res = cum(I-1,Y) + Y[I] + (I-1)
  end.
  
model() =>
  N = 20,
  Y = gamma_dist_n(3.0,1/0.04, N),
  Cum = [cum(I,Y) : I in 1..N],
  CumStep = [cond(C > 1000.0, C*(I-1),0) : I in 1..N, C = Cum[I] ],
  
  % A change point
  X = [cond(Cum[I] < 1001.0,1,0) : I in 1..N],
  Number = CumStep.max,

  Ix = [ cond(X[I]==1, I,0) : I in 1..N].max,
 
  add("number",Number),
  add("ix",Ix),
  add("x",X).

