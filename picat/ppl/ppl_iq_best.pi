go ?=>
  member(N, [10,100,1000]),
  println(n=N),
  reset_store,
  run_model(10_000,$model(N),[show_probs_trunc,mean,
                           show_simple_stats,
                           % show_percentiles,
                           show_hpd_intervals,hpd_intervals=[0.84,0.9,0.94,0.99,0.99999]
                           % show_histogram,
                           % min_accepted_samples=1000,show_accepted_samples=true
                          ]),
  nl,
  % show_store_lengths,nl,
  fail,
  nl.
go => true.
  
  
model(N) =>
  Men = normal_dist_n(100,15,N),
  Women = normal_dist_n(100,10,N),

  BestMan = Men.max,
  BestWoman = Women.max,
  P1 = check(BestMan > BestWoman),
  P2 = check(BestWoman > BestMan),  
  
  add("best man",BestMan),
  add("best woman",BestWoman),
  add("p1",P1),
  add("p2",P2).
  

