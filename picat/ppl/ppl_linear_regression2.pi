go ?=>
  reset_store,
  run_model(1_000_000,$model,[show_probs_trunc,mean]),
  nl,
  show_store_lengths,
  % fail,
  nl.
go => true.
  
  
model() =>
  Xs = 0..4,
  Ys = [0,2,4,6,8],

  M = normal_dist(0,1),
  B = normal_dist(0,1),
  Sigma = gamma_dist(1,1),

  ObsCrit = 0.1,

  foreach(I in 1..Xs.len)
    observe(abs(Ys[I]-(B+M*Xs[I])) <= ObsCrit)
  end,

  % predictions
  Post4=normal_dist(B + M*4,Sigma),
  Post5=normal_dist(B + M*5,Sigma),  
 
  
  if observed_ok then
    add("m",M),
    add("b",B),
    add("sigma",Sigma),
    add("post 4",Post4),
    add("post 5",Post5),    
  end.
