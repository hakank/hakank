go ?=>
  member(MaxGuests,[10,20,50,100]),
  MaxGuests = 100,
  println(max_quests=MaxGuests),
  reset_store,
  run_model(10_000,$model(MaxGuests),[show_probs_trunc,mean,truncate_size=10]),
  nl,
  fail,
  nl.
go => true.
  

% Generate the table of the next customer
% (or return a if all customers are placed).
f(A,MaxGuests) = Res =>
  Len = A.len,
  if A.sum >= MaxGuests then
    Res = A
  else
    if flip(1/(Len+1)) == true then
      % Pick a new empty table
      Res = f(A ++ [1],MaxGuests)      
    else
      % Pick a table proportion to the people already sitting there
      T = categorical(A,1..Len),
      NewA = [cond(I == T,A[I]+1,A[I]) : I in 1..Len],
      Res = f(NewA,MaxGuests)
    end
  end.
  
model(MaxGuests) =>
  A = f([1],MaxGuests),
  
  add("a",A),
  add("a[1]",A[1]),
  add("max a",A.max),
  add("len a",A.len).

