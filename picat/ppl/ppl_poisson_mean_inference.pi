go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs,mean]),
  nl,
  % show_store_lengths,
  % fail,
  nl.
go => true.
  
  
model() =>
  X = normal_dist(0,1),
  observe(X >= -4, X <=4 ),
  
  Y = poisson_dist(1 + abs(pow(X,3))*2),
  
  add("x",X),
  add("y",Y).

