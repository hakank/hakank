  4: 0.0023000000000000
  mean = 0.807

  var : max length
  Probabilities:
  2: 0.5200000000000000
  0: 0.4040000000000000
  3: 0.0682000000000000
  4: 0.0071000000000000
  5: 0.0004000000000000
  7: 0.0003000000000000
  mean = 1.2771


  n = 20
  var : num caravans
  Probabilities:
  0: 0.3864000000000000
