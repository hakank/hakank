go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  Lambda = 1/0.1,
  T1     = poisson_dist(Lambda),
  T2     = T1 + poisson_dist(Lambda),

  Diff = abs(T1-T2),
  
  add("t1",T1),
  add("t2",T2),
  add("t1,t2",[T1,T2]),
  add("diff",Diff).

