go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean,show_hpd_intervals]),
  nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  N = 15, % number of attempts
  K = 1,  % number of successes

  P = uniform(0,1),

  % Sample from binomial with updated P
  PosteriorPredictive = binomial_dist(N,P),

  % Sample fresh P
  PriorP = uniform(0,1),
  % sample from binomial with fresh p
  PriorPredictive = binomial_dist(N, PriorP),

  % Observed k number of successes, assuming a binomial
  observe(binomial_dist(N,P) == K),
  
 
  if observed_ok then
    add("prior p",PriorP),
    add("prior predictive",PriorPredictive),
    add("posterior p",P),
    add("posterior predictive",PosteriorPredictive)
  end.
