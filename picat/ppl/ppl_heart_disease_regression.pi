  0.000000000000007: 0.0645161290322581
  0.000000000000003: 0.0645161290322581
  0.000000000000003: 0.0645161290322581
  0.000000000000102: 0.0322580645161290
  .........
  0.000000000000005: 0.0322580645161290
  0.000000000000004: 0.0322580645161290
