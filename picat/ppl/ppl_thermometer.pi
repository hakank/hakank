go ?=>
  reset_store,
  run_model(10_000,$model,[mean,show_hpd_intervals]),
  nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  NoiseT = uniform_dist(3,8),
  NoiseM = uniform_dist(1,4),

  T1 = normal_dist(21,NoiseT),
  T2 = normal_dist(T1,NoiseT),

  M1 = normal_dist(T1,NoiseM),
  M2 = normal_dist(T2,NoiseM),

  add("noiseT",NoiseT),
  add("noiseM",NoiseM),
  add("m1",M1),
  add("m2",M2),
  add("t1",T1),  
  add("t2",T2).

