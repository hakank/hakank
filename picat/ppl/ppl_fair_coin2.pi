  (0.99999 13.333333333333334)
  HPD intervals:
  HPD interval (0.84): -4.36435780471985..4.36435780471985


*/
go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean,show_percentiles,show_hpd_intervals,hpd_intervals=[0.84]]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  Sample = bern_n(1/2,10),
  S = Sample.sum,
  Stdev = Sample.stdev,
  P = check(S == 7),
  P2 = check( (S <= 1 ; S >= 9)),
  Surprise = cond(Stdev != 0.0, (S - 5) / Stdev, 0),
  
  add("s",S),
  add("p",P),
  add("p2",P2),
  add("surprise",Surprise).

