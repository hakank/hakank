/* 

  Earthquakes (Pareto dist) in Picat.

  From Mathematica ParetoDistribution
  """
  Consider earthquake magnitudes recorded in the US from 1935 to 1989:

  The integer parts of the magnitudes recorded on a Richter scale can be modeled with a 
  ParetoDistribution:
    edist = EstimatedDistribution[magnitudes, ParetoDistribution(k, Alpha, Gamma, Mu)
    -> 
    ParetoDistribution[46.1666, 4374., 0.326152, 2.]

  Find the probability of an earthquake with magnitude at least 6 on the Richter scale:
    NProbability[x >= 6, x -> edist]
    -> 0.0889446

  Find the average magnitude:
  Mean(edist)
  -> 4.68

  """

  For the 2 parameter version ParetoDistribution[k, alpha]:
  """
  edist = EstimatedDistribution[magnitudes,  ParetoDistribution[k, alpha]]
  -> ParetoDistribution[2., 1.18656]
  
  NProbability[x >= 6, x -> edist]
  """

  This program was created by Hakan Kjellerstrand, hakank@gmail.com
  See also my Picat page: http://www.hakank.org/picat/

*/

import ppl_distributions, ppl_utils.
import util.
% import ordset.

main => go.

