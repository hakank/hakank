  HPD interval (0.94): 2.60946006635645..5.13766806811917


  Compare with Mathematica:
  FindDistributionParameters[data, LaplaceDistribution[mu, sigma]] 
  -> {mu -> 10.1308, sigma -> 3.30752}

*/
go2 ?=>
  Data = laplace_dist_n(10,3.4,40),
  println(data=Data),
  reset_store,
  run_model(10_000,$model2(Data),[show_probs_trunc,mean,show_percentiles,
                                  show_hpd_intervals,hpd_intervals=[0.94],
                                  min_accepted_samples=100,show_accepted_samples=true
                                  ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go2 => true.
  
  
model2(Data) =>
  Mu = uniform(0,100),
  Sigma = uniform(0,20),
  
  X = laplace_dist_n(Mu,Sigma,Data.len),

  observe_abc(Data,X,1/10),

  if observed_ok then
    add("mu",Mu),
    add("sigma",Sigma)
  end.

