  (0.99 23.384345610996593)
  (0.999 30.369129475837404)
  (0.9999 35.070809500650171)
  (0.99999 38.132242889203326)
  HPD intervals:
  HPD interval (0.84): 3.88538137399407..16.23145811408844

  var : p
  Probabilities:
  false: 0.8818000000000000
  true: 0.1182000000000000
  mean = [false = 0.8818,true = 0.1182]
  Percentiles:
  (0.001 false)
  (0.01 false)
  (0.025 false)
  (0.05 false)
  (0.1 false)
  (0.25 false)
  (0.5 false)
  (0.75 false)
  (0.84 false)
  (0.9 true)
  (0.95 true)
  (0.975 true)
  (0.99 true)
  (0.999 true)
  (0.9999 true)
  (0.99999 true)
  HPD intervals:
  show_hpd_intervals: data is not numeric

*/
go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean,show_percentiles,
                           show_hpd_intervals,hpd_intervals=[0.84]]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  Mu = 10,
  Sigma = 3.4,
  D = laplace_dist(Mu,Sigma),

  P = check(abs(D) > 15),
  
  add("d",D),
  add("p",P).


