8: 0.0000600000000000
10: 0.0000200000000000
mean = 2.7196


n = 100
var : a
Probabilities:
2: 0.4978200000000000
3: 0.3374400000000000
4: 0.1245600000000000
5: 0.0321800000000000
6: 0.0066200000000000
7: 0.0011600000000000
8: 0.0002000000000000
9: 0.0000200000000000
mean = 2.71672



*/
go ?=>
  member(N,[10,20,100]),
  println(n=N),
  reset_store,
  run_model(50_000,$model(N),[show_probs_trunc,mean]),
  nl,
  fail,
  nl.
go => true.
  

f(C,Cs,N) = Res =>
  if Cs == [] then
    Res = N
  else
    T = Cs.first,
    if T < C then
      Res = N + 1
    else
      Res = f(Cs.first,Cs.rest,N+1)
    end
  end.


model(N) =>
  Cards = draw_without_replacement(N,1..N),
  % Cards = shuffle(1..N),
  A = f(Cards.first,Cards.rest,1),
  add("a",A).

