go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,show_simple_stats,
                           % show_percentiles,
                           % show_hpd_intervals,hpd_intervals=[0.94],
                           show_scatter_plot,
                           show_histogram
                           % min_accepted_samples=1000,show_accepted_samples=true
                          ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  D1 = student_t_dist(2),
  D2 = student_t_dist(1,2,3),
  
  add("d1",D1),
  add("d2",D2).



