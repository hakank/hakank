go4 => true.
  

model4(Data) =>
  Len = Data.len,

  % Uninformed priors
  N = random_integer1(1000),

  Y = random_integer1_n(N,Len),
  
  observe_abc(Data,Y),
  
  if observed_ok then
    add("N",N),
  end.



