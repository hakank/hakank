go2 ?=>
  N = 40,
  P = 1/7,
  Dist = $binomial_dist_n(10,P,N),
  println(dist=Dist),
  Data = Dist.apply,
  println(data=Data),
  println([n=N,mean=Data.mean,stdev=Data.stdev]),
  reset_store,
  run_model(10_000,$model2(Data),[show_probs_trunc,mean,
                           % show_percentiles,show_histogram,
                           % show_hpd_intervals,hpd_intervals=[0.84],
                           min_accepted_samples=1000,show_accepted_samples=true
                          ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go2 => true.
  
  
model2(Data) =>
  Len = Data.len,

  % Uninformed priors
  N = uniform(1,100),
  P = beta_dist(1,1),

  Y = binomial_dist_smart_n(N,P,Len),
  
  observe_abc(Data,Y,1/4),
  
  if observed_ok then
    add("N",N),
    add("P",P),    
  end.



