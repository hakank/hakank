go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs,mean,
                           show_percentiles,
                           show_hpd_intervals,hpd_intervals=[0.01,0.84,0.9,0.95,0.99,0.99999],
                           show_histogram
                           % min_accepted_samples=1000,show_accepted_samples=true
                          ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  Classes = 365,
  Coincident = 2,

  B = birthday_dist(Classes,Coincident),
  P = check(B <= 23),
  add("b",B),
  add("p",P).

