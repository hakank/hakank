go3 ?=>
  member(K,[1,10]),
  println(k=K),
  reset_store,
  run_model(10_000,$model3(K),[show_probs_trunc,mean,show_percentiles,show_hpd_intervals]),
  nl,
  fail,
  nl.
go3 => true.

model3(K) =>
  Mu = 100,
  Sigma = 15,
  N = 10, % we have N ordered measurements
  % K = 1, % we want to check the K'th value
  Xs = normal_dist_n(Mu,Sigma,N).sort,

  % M = Xs[K],
  M = ith_smallest(Xs,K,true),
  
  add("m",M).

