go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean,show_histogram]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  X = poisson_dist(100),
  Y = normal_dist(0,0.1),
  
  add("x",X),
  add("y",Y).

