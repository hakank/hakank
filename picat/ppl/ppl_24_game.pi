   [numbers = [1,2,3,4],target = 14,num_solutions = 51]
   [numbers = [1,2,3,4],target = 15,num_solutions = 13]
   [numbers = [1,2,3,4],target = 16,num_solutions = 27]
   [numbers = [1,2,3,4],target = 17,num_solutions = 4]
   [numbers = [1,2,3,4],target = 18,num_solutions = 30]
   [numbers = [1,2,3,4],target = 19,num_solutions = 24]
   [numbers = [1,2,3,4],target = 20,num_solutions = 28]
   [numbers = [1,2,3,4],target = 21,num_solutions = 10]
