  N = random_integer1(10),
  Numbers = random_integer1_n(30,N),
  Target = random_integer(100),
  println([numbers=Numbers,target=Target,n=N]),
  reset_store,
  run_model(10_000,$model(Numbers,Target),[ presentation=[],
                           min_accepted_samples=20,show_accepted_samples=true
                          ]),
  Store = get_store(),
  C = 0,
  foreach(V in Store.get("res").remove_dups.sort)
    println(V.map(first)),
    C := C + 1,
  end,
  println(num_solutions=C),  
  fail,
  nl,
  nl.
go3 => true.
