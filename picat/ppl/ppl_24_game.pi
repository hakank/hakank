/* 

  24 Game in Picat.

  From Rosetta Code
  http://rosettacode.org/wiki/24_game/Solve
  """
  Write a function that given four digits subject to the rules of the 24 game, computes an 
  expression to solve the game if possible.

  Show examples of solutions generated by the function 
  """

  Cf
  - 24_game.pi 
  - my Gamble model gamble_24_game.rkt

  This program was created by Hakan Kjellerstrand, hakank@gmail.com
  See also my Picat page: http://www.hakank.org/picat/

*/

import ppl_distributions, ppl_utils.
import util.
% import ordset.

main => go.

/*

  [numbers = [1,2,3,4],target = 24]
  min_accepted_samples = 1000
  Solutions:
  [1 * 2 = 2,2 * 3 = 6,6 * 4 = 24]
  [1 * 2 = 2,2 * 4 = 8,8 * 3 = 24]
  [1 * 3 = 3,3 * 2 = 6,6 * 4 = 24]
  [1 * 3 = 3,3 * 4 = 12,12 * 2 = 24]
  [1 * 4 = 4,4 * 2 = 8,8 * 3 = 24]
  [1 * 4 = 4,4 * 3 = 12,12 * 2 = 24]
  [1 + 2 = 3,3 + 3 = 6,6 * 4 = 24]
  [1 + 3 = 4,4 + 2 = 6,6 * 4 = 24]
  [2 * 1 = 2,2 * 3 = 6,6 * 4 = 24]
