go3 ?=>
  N = 100,
  println("PN:"),
  PN = [pn(N,K) :  K in 1..N],
  println(pn=PN),
  PNArgMax = argmax(PN).first,
  
  println([argmax=PNArgMax,ix=PN[PNArgMax]]),
  nl,
  println("PNK:"),
  PNK = [pnk(N,K) :  K in 2..N],
  println(pnk=PNK),
  nl.
go3 => true.
  
