go ?=>
  reset_store,
  run_model(100_000,$model,[show_probs_trunc,mean]),
  nl,
  show_store_lengths,
  % fail,
  nl.
go => true.
  
  
model() =>
  N = 3,
  Cluster = poisson_dist(3)+1, % Number of clusters
  % Mu = normal_dist_n(0,10,Cluster),

  Z = random_integer_n(Cluster,N),

  X = [normal_dist(Z[D],0.1) : D in 1..N],

  observe(abs(X[1]-0.1) <= 0.01), % omit other data points
  % observe(abs(X[2]-0.1) <= 0.01), % omit other data points
  % observe(abs(X[3]-0.1) <= 0.01), % omit other data points  
  
  if observed_ok then
    add("cluster",Cluster),
    add("x1",X[1]),
    add("x2",X[2]), 
    add("x3",X[3]),   
  end.
