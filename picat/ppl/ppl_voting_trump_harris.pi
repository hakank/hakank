false: 0.9999000000000000
true: 0.0001000000000000
mean = 0.0001

var : no win
Probabilities:
false: 0.8182000000000000
true: 0.1818000000000000
mean = 0.1818


[trump_prob = 0.476,harris_prob = 0.485,num_votes = 20]
var : trump
mean = 9.4554

var : harris
mean = 9.7577

var : other
