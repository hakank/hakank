go2 ?=>
  N = 20,
  println(n=N),
  reset_store,
  run_model(10_000,$model2(N),[show_probs_trunc,mean,show_percentiles]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go2 => true.
  
  
model2(N) =>

  X = random_integer1(N),
  Y = random_integer1(N),
  Z = random_integer1(N*N),

  VMax = max(X,Y),
  VSqrt = ceiling(sqrt(Z)),

  Diff = VMax-VSqrt,
  add("v max",VMax),
  add("v sqrt",VSqrt),
  add("diff",Diff).

