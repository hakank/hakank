go ?=>
  NumSamples = 250,
  Data = poisson_dist_n(20,NumSamples),
  println(data=Data),
  show_simple_stats(Data),
  reset_store,
  run_model(10_000,$model(Data),[show_probs_trunc,mean,
                                 show_simple_stats,
                                 show_hpd_intervals,hpd_intervals=[0.84,0.9,0.95,0.99],
                                 show_percentiles,                           
                                 show_histogram,
                                 min_accepted_samples=1000,show_accepted_samples=true
                          ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model(Data) =>
  Lambda = normal_dist(Data.mean,1),

  X = poisson_dist_n(Lambda,Data.len),
  
  % observe_abc(Data,X),
  observe_abc(Data,X,1/10),

  Post = poisson_dist(Lambda),
  P = check1(Post > 20),
  
  if observed_ok then
    add("lambda",Lambda),
    add("post",Post),
    add("p",P),
  end.
