  cards = [10,12,11,2,11,11,3,7,9,8,1,5,6,9,4,3,2,7,6,2,5,8,13,13,3,9,1,10,10,2,10,12,6,4,4,12,4,9,6,1,1,5,8,7,5,11,13,8,3,12,7,13]
  var : a
