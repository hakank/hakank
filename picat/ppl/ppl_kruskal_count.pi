  cards = [8,3,4,8,5,7,6,12,2,8,2,7,7,6,13,11,9,3,13,5,8,12,6,1,3,11,4,12,11,13,5,1,9,12,3,4,5,9,7,9,10,1,13,1,11,10,6,4,10,2,2,10]
  var : a
  Probabilities:
  [9,2,7,5,3,12,9,1,13,4]: 0.1200000000000000
