  mean = 0.3689

  theoretical_mean = 1
  theoretical_prob_of_0 = 0.367879
  PDF:
   0 0.367879441171442 
   1 0.367879441171442 
   2 0.183939720585721 
   3 0.06131324019524 
   4 0.01532831004881 
   5 0.003065662009762 
   6 0.000510943668294 
   7 0.000072991952613 
   8 0.000009123994077 
   9 0.00000101377712 
  10 0.000000101377712 
