go2 ?=>
  Data = kumaraswamy_dist_n(5,2,100),
  println(data=Data),
  reset_store,
  run_model(10_000,$model2(Data),[show_probs_trunc,mean,
                           % show_percentiles,
                           % show_hpd_intervals,hpd_intervals=[0.94],
                           % show_histogram
                           min_accepted_samples=1000,show_accepted_samples=true
                          ]),
  nl,
  show_store_lengths,nl,
  % fail,
  nl.
go2 => true.
  
  
model2(Data) =>
  A = uniform(0.01,10),
  B = uniform(0.01,10),  
  X = kumaraswamy_dist_n(A,B,Data.len),

  % observe_abc(Data,X,1/10),
  observe_abc(Data,X,1,[mean,stdev,kurtosis,skewness]),  

  if observed_ok then
    add("a",A), 
    add("b",B),   
  end.

