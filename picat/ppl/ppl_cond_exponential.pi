go ?=>
  reset_store,
  run_model(100_000,$model,[show_probs_trunc,mean,show_percentiles,
                           show_hpd_intervals,hpd_intervals=[0.94],
                           show_histogram]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  X = exponential_dist(1),
  Y = exponential_dist(1),  
  
  observe((X > 1, Y > 1)),

  E = (X+Y)**2,

  if observed_ok then
    add("x",X),
    add("y",Y),
    add("e",E),    
  end.
