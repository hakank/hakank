go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean,
                           show_hpd_intervals,hpd_intervals=[0.5,0.84,0.95,0.99]
                           ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  G1 = gumbel_dist(0,1),
  G2 = gumbel_dist(1/2,1),  
  G3 = gumbel_dist(1,2),
  G4 = gumbel_dist(10,10),

  add("g1",G1),
  add("g2",G2),
  add("g3",G3), 
  add("g4",G4).

