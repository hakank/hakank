/* 

  Max stable distribution in Picat.

  From Mathematica MaxStableDistribution

  This is also called Generalized Extreme Value distribution 
  (for maximum values).

  Cf my Gamble model gamble_max_stable_dist.rkt

  This program was created by Hakan Kjellerstrand, hakank@gmail.com
  See also my Picat page: http://www.hakank.org/picat/

*/

import ppl_distributions, ppl_utils.
import util.

main => go.

/*

  var : d
  Probabilities (truncated):
  68495.996019391619484: 0.0001000000000000
  8649.559211176370809: 0.0001000000000000
  7990.078222660015854: 0.0001000000000000
  4847.668887637149965: 0.0001000000000000
  .........
  0.106898646273663: 0.0001000000000000
  0.102210362951394: 0.0001000000000000
  0.10140909994393: 0.0001000000000000
  0.10105672708781: 0.0001000000000000
  mean = 20.2922

  var : p
  Probabilities:
  true: 0.6324000000000000
  false: 0.3676000000000000
  mean = [true = 0.6324,false = 0.3676]

*/
go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean]),
  nl,
  % show_store_lengths,
  % fail,
  nl.
go => true.
  
  
model() =>
  Mu = 2,
  Sigma = 2,
  Xi = 0.9,

  D = max_stable_dist(Mu,Sigma,Xi),
  P = check(D >= Mu),
  add("d",D),
  add("p",P).


