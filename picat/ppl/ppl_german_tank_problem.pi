go ?=>

  Observations = [10,256,202,97], 
  println(observations=Observations),
  MaxInt = 1000,  
  reset_store,
  run_model(10_000,$model(Observations,MaxInt),[show_probs_trunc,mean,
                                                show_histogram,
                                                min_accepted_samples=100,show_accepted_samples=true
                                               ]),
  nl.
go => true.
  
  
model(Observations,MaxInt) =>
  Len = Observations.len,
  MaxObs = Observations.max,

  N = random_integer1(MaxInt),
  
  Probs = [1/N : _ in 1..N],
  Values = 1..N,
  Y = categorical_n(Probs,Values,Observations.len),

  observe(N >= MaxObs),
  observe_abc(Observations,Y,1/3),
  
  if observed_ok then
    add("N",N),
  end.


