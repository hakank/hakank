go2 ?=>
  Payroll = [192.7,179.5,164.8,155.7,150.3,143,139.9,138.3,137.4,137.3,137.1,131.8,128.3,124,
             123,122.8,116,115.4,109.9,104.5,104.2,101.1,94.6,85.5,84,78.5,67.7,67.6],
  Rank    = [3,4,1,2,14,9.5,11,8,25,19.5,6,7,5,18,21,12,15.5,9.5,26,
             13,17,22,27,23.5,28,19.5,23.5,15.5],
  SumProductsOrig = [P*R : {P,R} in zip(Payroll,Rank)].sum,
  println(sum_products_orig=SumProductsOrig),
  reset_store,
  run_model(20_000,$model2(Payroll,Rank,SumProductsOrig),
                   [show_probs_trunc,mean,show_percentiles,show_histogram,show_hpd_intervals,hpd_intervals=[0.95]]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go2 => true.
  
  
model2(Payroll,Rank,SumProductsOrig) =>
  PayrollSample = draw_without_replacement(Payroll),
  RankSample    = draw_without_replacement(Rank),

  SumProducts = [P*R : {P,R} in zip(PayrollSample,RankSample)].sum,
  % How often is the sum of products as low as in the original?

  P = check1(SumProducts <= SumProductsOrig),

  add("sum products",SumProducts),
  add("p",P).

