  reset_store(),
  run_model(1_000_000,$model2,[show_probs_rat_trunc,mean,show_hpd_intervals,
                               min_accepted_samples=100,show_accepted_samples=true]),
  % fail,
  show_store_lengths(),
  nl.
go2 => true.


model2() =>
  Male2 = 251527,
  Female = 241945,
  Theta = beta_dist(100,100),
  Male = binomial_dist_smart(Male2+Female,Theta),
  
  observe(Male == 251527),
  
  if observed_ok  then
    add("theta>0.5",cond(Theta>0.5,1,0)),
    add("theta",Theta)
  end.

              