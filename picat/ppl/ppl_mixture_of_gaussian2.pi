go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean,
                           % show_percentiles,show_histogram,
                           % show_hpd_intervals,hpd_intervals=[0.84],
                           min_accepted_samples=1000,show_accepted_samples=true
                          ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  N = 5,
  P = beta_dist(0.5,1),

  Z = bern_n(P,N),

  A = normal_dist(-1,1),
  B = normal_dist(-1,1),  

  Y = [ cond(Z[I]==1,normal_dist(A,1),normal_dist(B,1)) : I in 1..N],

  Data = [0.2,0.5,1.0,0.5,0.6],
  observe_abc(Data,Y),
  
  if observed_ok then
    add("a",A),
    add("b",B),
    add("p",P),
    add("min a,b",min(A,B)),    
  end.
