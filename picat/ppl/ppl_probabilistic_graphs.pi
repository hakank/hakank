/* 

  Probabilistic graphs in Picat.

  https://dtai.cs.kuleuven.be/problog/tutorial/basic/04_pgraph.html
  ProbLog model:
  """
  0.6::edge(1,2).
  0.1::edge(1,3).
  0.4::edge(2,5).
  0.3::edge(2,6).
  0.3::edge(3,4).
  0.8::edge(4,5).
  0.2::edge(5,6).

  path(X,Y) :- edge(X,Y).
  path(X,Y) :- edge(X,Z),
               Y \== Z,
               path(Z,Y).

  query(path(1,5)).
  query(path(1,6)).
  query(path(5,2)).
  """
 
  Results from the ProbLog model
  """
  path(1,5): 0.25824    (i.e. 0->4)
  path(1,6): 0.2167296  (i.e. 0->5)
  """

  Cf my Gamble model gamble_probabilistic_graphs.rkt

  This program was created by Hakan Kjellerstrand, hakank@gmail.com
  See also my Picat page: http://www.hakank.org/picat/

*/

import ppl_distributions, ppl_utils.
import util.

main => go.

