go => true.
  
  
model(As,Bs) =>
  PA = beta_dist(1,1), % true prob 0.05
  PB = beta_dist(1,1), % true prob 0.04

  A = bern_n(PA,As.len),
  observe_abc(As,A,1/2),

  B = bern_n(PB,Bs.len),
  observe_abc(Bs,B,1/2),

  Diff = PA - PB,
  AgtB = check(Diff > 0),
  
  if observed_ok then
    add("pa",PA),
    add("pb",PB),
    add("diff",Diff),
    add("a > b",AgtB),    
  end.
