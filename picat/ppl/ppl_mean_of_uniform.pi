go3 ?=>
  run_model(100,model2,[presentation=[]]),
  Data = get_store().get("m"),
  println(data=Data),
  println([min=Data.min,mean=Data.mean,max=Data.max,stdev=Data.stdev]),
  reset_store,
  run_model(10_000,$model3(Data),[show_probs_trunc,mean,
                           show_percentiles,
                           min_accepted_samples=1000,show_accepted_samples=false
                          ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go3 => true.
  
  
model3(Data) =>
  Mu = uniform(0,10),
  Sigma = uniform(0,5),

  X = normal_dist_n(Mu,Sigma,Data.len),
  observe_abc(Data,X),

  Post = normal_dist(Mu,Sigma),

  if observed_ok then
    add("mu",Mu),
    add("sigma",Sigma),
    add("post",Post),
  end.

