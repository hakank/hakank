go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean,
                           show_percentiles
                          ]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  N = 10,
  Sample = random_integer1_n(N,N),

  M = Sample.mean,
  S = Sample.sum,
  P = check(M >= 8),
  
  add("m",M),
  add("s",S),
  add("p",P).

