go ?=>
  reset_store,
  run_model(500_000,$model,[show_probs_trunc,mean,show_histogram]),
  nl,
  % fail,
  nl.
go => true.
  
  
model() =>
  Pr = uniform(0,1),
  P = flip(Pr),

  X = condt(P,
            normal_dist(10.0,1.0),
            normal_dist(14.0,0.5)),

  observe(abs(X-14.5) <0.1),

  if observed_ok then
    add("pr",Pr),
    add("p",P),
    add("x",X)
  end.
