go ?=>
  member(Pattern,[[0,1],[1,1],[1,1,1],[1,0,1],[1,1,0],[0,1,1]]),
  println(pattern=Pattern),
  reset_store,
  run_model(10_000,$model(Pattern),[show_probs_trunc,mean]),
  nl,
  % show_store_lengths,
  fail,
  nl.
go => true.
  

flip_sequence(A,Pattern) = Res =>
  Len = A.len,
  PatternLen = Pattern.len,
  if Len >= PatternLen, Pattern == A[Len-PatternLen+1..Len] then
    Res = A
  else
    Res = flip_sequence(A ++ [bern(1/2)],Pattern)
  end.
model(Pattern) =>
  A = flip_sequence([],Pattern),
  Len = A.len,
  add("a",A),
  add("len",Len).

