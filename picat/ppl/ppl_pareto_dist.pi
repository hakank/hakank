go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs_trunc,mean,show_hpd_intervals,hpd_intervals=[0.84],
                           show_percentiles]),
  nl,
  % show_store_lengths,
  % fail,
  nl.
go => true.
  
  
model() =>
  X = 6820,
  Alpha = 4,
  V1 = pareto1_dist(X,Alpha),
  Prob1 = check(V1 >= 7000),
  
  add("V1",V1),
  add("prob1",Prob1).  
