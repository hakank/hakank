  true: 0.2503000000000000
  mean = 0.2503

*/
go ?=>
  reset_store,
  run_model(10_000,$model,[show_probs,mean]),
  nl,
  % show_store_lengths,nl,
  % fail,
  nl.
go => true.
  

prob() = uniform_draw(0..3).

f(NumAliens,Steps,Limit) = Res =>
  if NumAliens == 0 ; Steps >= Limit then
    Res = NumAliens
  else
    A = prob(),
    if A == 0 then
      Res = 0
    else
      Res = A + sum([f(1,Steps+1,Limit) : _ in 1..NumAliens])
    end
  end.

model() =>
  Limit = 100,
  A = f(1,0,Limit),
  P = check(A == 0),
  
  add("a",A),
  add("p",P).

