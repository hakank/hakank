go ?=>
  member(Cluster,[none,1,2,3]),
  println(cluster=Cluster),
  reset_store,
  run_model(10_000,$model(Cluster),
                          [show_probs_trunc,mean,show_hpd_intervals,hpd_intervals=[0.94],
                           show_histogram]),
  nl,
  % show_store_lengths,
  fail,
  nl.
go => true.
  
  
model(Cluster) =>
  
  C = categorical([1/3,1/3,1/3],1..3),

  X = cases([[C==1, 0.525 * normal_dist(-8,2)],
             [C==2, 0.100 * normal_dist(0,2)],
             [true, 0.375 * normal_dist(7,3)]]),

  observe( ((X >0, X < 10)
           ;
           (X > -6, X < 3)
           )),

  if Cluster != none then
    observe(C == Cluster)
  end,

  if observed_ok then
    add("c",C),
    add("x",X)
  end.
