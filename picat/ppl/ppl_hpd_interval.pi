go ?=>
  member([Dist,Type], [ [$poisson_dist(10),discrete],
                        [$binomial_dist(10,1/2),discrete],
                        [$normal_dist(100,15),continuous]
                       ]),
  println(dist=Dist),
  println("Compare with exact (and the wider) credible Intervals for the distribution:"),
  % Qs = quantile_qs(),  
  Qs = [0.5,0.84,0.90,0.94,0.95,0.99,0.999,0.9999,0.99999],
  show_credible_intervals_exact(Dist,Qs),
  reset_store,
  if Type == discrete then
    run_model(10_000,$model(Dist),[show_probs,mean,show_percentiles,
                                   show_hpd_intervals,hpd_intervals=Qs                                
                                   ])
  else
    run_model(10_000,$model(Dist),[show_probs_trunc,mean,show_percentiles,
                                   show_hpd_intervals,hpd_intervals=Qs])  
  end,
  nl,
  % show_store_lengths,nl,
  fail,
  nl.
go => true.


model(Dist) =>
  P = apply(Dist),
  add("p",P).
