#lang gamble

; (require gamble/viz)
(require racket)
(require "gamble_utils.rkt")
; (require "gamble_distributions.rkt")


(define (model)
  (enumerate
   ; rejection-sampler
   ; importance-sampler
   ; mh-sampler

   (define start 2)

   (define target 1)   

   (define limit 25)

   (define (hop k n)
     (if (or (= k target) (> n limit))
         (list k n)
         (let [(h (categorical-vw (vector (- k 1) (+ k 1)) (vector (/ 1 k) (/ (- k 1) k))))]
           (hop h (add1 n)))))


   (define res (hop 2 0))

   (define last-pad (first res))
   (define len (second res))
   (define p (= last-pad 1))

   ; (show2 "last-pad" last-pad "len" len "p" p)
   
   (list last-pad len p)
   

   )
)

(show-marginals (model)
                (list "last-pad"
                      "len"
                      "p"
                       )
                #:num-samples 100000
                #:truncate-output 5
