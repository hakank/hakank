(define (model n)
  (; enumerate #:limit 1e-01
   ; rejection-sampler
   importance-sampler
   ; mh-sampler

   (define rolls (for/list ([i n]) (b2i (and (= (uniform-draw dice) 1) (= (uniform-draw dice) 1)))))
   (define s (sum rolls))

   (define p (>= s 5))

   (list s p)

   )
)


; (for ([n '(25 50 100 200 250 300 500 1000)])
(for ([n '(25)])  
  (newline)
  (show "n" n)
  (show2 "exact prob: " (- 1 (dist-cdf (binomial-dist n 1/36) (- 5 1))))
  (show2 "mean: " (dist-mean (binomial-dist n 1/36)))  
  (show-marginals (model n)
                  (list  "s"
                         "p"
                         )
                  #:num-samples 10000
                  ; #:truncate-output 5
                  ; #:skip-marginals? #t
                  ; #:show-stats? #t
                  ; #:credible-interval 0.84
                  ; #:hpd-interval (list 0.84 0.9 0.94 0.99 0.999 0.9999999)
                  #:show-histogram? #t
                  ; #:show-percentiles? #t
                  ; #:burn 0
                  ; #:thin 0
                  )
  
  )


